---
const { photos } = Astro.props;
---

<dialog class="lightbox" id="lightbox">
  <button class="close" aria-label="Close">&times;</button>
  <button class="nav prev" aria-label="Previous photo">&#8249;</button>
  <button class="nav next" aria-label="Next photo">&#8250;</button>
  <figure>
    <img id="lb-img" src="" alt="" />
    <figcaption>
      <span id="lb-caption"></span>
      <span id="lb-exif"></span>
      <span id="lb-meta"><span id="lb-filename"></span><span id="lb-date"></span></span>
      <span class="lb-links">
        <a id="lb-full" href="" target="_blank" rel="noopener">View full resolution</a>
        <button id="lb-copy" type="button">Copy link</button>
      </span>
    </figcaption>
  </figure>
</dialog>

<script is:inline define:vars={{ photos }}>
  (() => {
    const dialog = document.getElementById('lightbox');
    const img = document.getElementById('lb-img');
    const captionEl = document.getElementById('lb-caption');
    const exifEl = document.getElementById('lb-exif');
    const filenameEl = document.getElementById('lb-filename');
    const dateEl = document.getElementById('lb-date');
    const fullEl = document.getElementById('lb-full');
    let current = 0;

    function exifLine(exif) {
      return [
        exif.camera,
        exif.lens,
        exif.aperture,
        exif.shutter,
        exif.iso ? `ISO ${exif.iso}` : null,
      ]
        .filter(Boolean)
        .join(' · ');
    }

    // capturedAt is local wall-clock ("2026-07-14T18:59:08"); write it out as
    // e.g. "July 14, 2026 · 6:59 PM".
    function formatCaptured(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      if (isNaN(d)) return '';
      const date = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      const time = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
      return `${date} · ${time}`;
    }

    function show(index) {
      current = (index + photos.length) % photos.length;
      const photo = photos[current];

      img.src = photo.med;
      img.alt = photo.caption ?? '';

      captionEl.textContent = photo.caption ?? '';
      captionEl.hidden = !photo.caption;

      const line = exifLine(photo.exif ?? {});
      exifEl.textContent = line;
      exifEl.hidden = line === '';

      filenameEl.textContent = photo.id;

      const captured = formatCaptured(photo.exif?.capturedAt);
      dateEl.textContent = captured;
      dateEl.hidden = captured === '';

      fullEl.href = photo.full;

      // Put the photo id in the URL so it's shareable: whoever opens the link
      // lands on this exact photo. replaceState (not push) keeps the back button
      // sane while paging with next/prev.
      history.replaceState(null, '', `#${photo.id}`);
    }

    function openAt(index) {
      show(index);
      if (!dialog.open) dialog.showModal();
    }

    document.querySelectorAll('.tile').forEach((tile) => {
      tile.addEventListener('click', () => openAt(Number(tile.dataset.index)));
    });

    dialog.querySelector('.close').addEventListener('click', () => dialog.close());
    dialog.querySelector('.prev').addEventListener('click', () => show(current - 1));
    dialog.querySelector('.next').addEventListener('click', () => show(current + 1));

    // Copy a shareable link to the current photo.
    const copyBtn = dialog.querySelector('#lb-copy');
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Link copied';
        setTimeout(() => { copyBtn.textContent = original; }, 1500);
      } catch {
        copyBtn.textContent = location.href;
      }
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });

    // Clicking the backdrop (the dialog itself, outside the figure) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Closing clears the photo from the URL so the link points at the album.
    dialog.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search);
    });

    // Deep-link: open the photo named in the URL hash — but only once the gallery
    // is unlocked, so a shared link can't bypass the password gate.
    function openFromHash() {
      const id = decodeURIComponent(location.hash.replace(/^#/, ''));
      if (!id) return;
      if (sessionStorage.getItem('zouf-gallery-unlocked') !== '1') return;
      const index = photos.findIndex((p) => p.id === id);
      if (index !== -1) openAt(index);
    }

    openFromHash();
    // If the visitor arrives locked, open the linked photo right after they unlock.
    window.addEventListener('gallery-unlocked', openFromHash);
  })();
</script>

<style>
  .lightbox {
    border: 0;
    padding: 0;
    margin: 0;
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    background: #14110e;
    color: #f0ebe4;
  }

  .lightbox::backdrop {
    background: rgba(20, 17, 14, 0.94);
  }

  .lightbox figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 3rem 4rem;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 76dvh;
    object-fit: contain;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  #lb-caption {
    font-size: 0.95rem;
  }

  #lb-exif,
  #lb-full {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a9086;
  }

  #lb-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 0.9rem;
  }

  #lb-date {
    font-size: 0.72rem;
    color: #9a9086;
  }

  #lb-filename {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: #6f665d;
  }

  .lb-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  #lb-copy {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a9086;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  #lb-copy:hover {
    color: #f0ebe4;
    border-bottom-color: #9a9086;
  }

  #lb-full {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  #lb-full:hover {
    color: #f0ebe4;
    border-bottom-color: #9a9086;
  }

  .close,
  .nav {
    position: fixed;
    background: none;
    border: 0;
    color: #9a9086;
    cursor: pointer;
    line-height: 1;
    padding: 0.75rem;
    transition: color 0.15s;
  }

  .close {
    top: 0.5rem;
    right: 0.75rem;
    font-size: 2rem;
  }

  .nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2.75rem;
  }

  .prev {
    left: 0.25rem;
  }

  .next {
    right: 0.25rem;
  }

  .close:hover,
  .nav:hover {
    color: #f0ebe4;
  }

  .close:focus-visible,
  .nav:focus-visible {
    outline: 2px solid #f0ebe4;
    outline-offset: 2px;
  }

  @media (max-width: 560px) {
    .lightbox figure {
      padding: 3rem 1rem;
    }

    .nav {
      font-size: 2rem;
    }
  }
</style>
