---
// Client-side password gate. This keeps casual visitors and search engines out;
// it is NOT real security. A determined visitor can read the page source or
// fetch image URLs directly. For genuine protection the site would need
// server-side auth (a Cloud Function in front of Hosting) and private storage.
//
// Deliberately a plain synchronous string comparison — no Web Crypto. crypto.subtle
// needs a secure context and can be unavailable or throw in some in-app browsers,
// where it would fail silently and the gate would just never open. Since this is a
// soft lock with a shared password, correctness beats hiding the plaintext.
const PASSWORD = 'ilovebikes';

// Build-time stamp so we can confirm a fresh version is being served (i.e. the
// cache fix is working). Compact UTC like "0722-2114".
const now = new Date();
const p = (n) => String(n).padStart(2, '0');
const BUILD_VERSION = `${p(now.getUTCMonth() + 1)}${p(now.getUTCDate())}-${p(now.getUTCHours())}${p(now.getUTCMinutes())}`;

// The entrance shows the saguaro before login. This image is public by design
// (the whole point is to greet visitors); the rest of the gallery stays gated.
import manifest from '../../photos.json';
const allPhotos = manifest.albums.flatMap((a) => a.photos);
const entrance =
  allPhotos.find((ph) => ph.id === 'DSC_1478') ?? allPhotos[0];
---

<div class="gate" id="password-gate" hidden>
  {entrance && <img class="gate-bg" src={entrance.med} alt="" aria-hidden="true" />}
  <div class="gate-scrim"></div>
  <form class="gate-form" id="gate-form">
    <p class="gate-title">Let's Explore</p>
    <label class="gate-label" for="gate-input">Enter the password to view the gallery</label>
    <div class="gate-row">
      <input
        class="gate-input"
        id="gate-input"
        type="password"
        name="gallery-access"
        autocomplete="off"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        aria-label="Password"
        autofocus
      />
      <button class="gate-submit" type="submit">Enter</button>
    </div>
    <p class="gate-error" id="gate-error" hidden>Incorrect password</p>
  </form>
  <p class="gate-version">v{BUILD_VERSION}</p>
</div>

<script is:inline define:vars={{ PASSWORD }}>
  (() => {
    const KEY = 'zouf-gallery-unlocked';
    const root = document.documentElement;
    const gate = document.getElementById('password-gate');
    const form = document.getElementById('gate-form');
    const input = document.getElementById('gate-input');
    const error = document.getElementById('gate-error');

    function unlock() {
      root.classList.remove('locked');
      gate.hidden = true;
      // Let the lightbox open a deep-linked photo now that we're unlocked.
      window.dispatchEvent(new Event('gallery-unlocked'));
    }

    // Already unlocked this session? Reveal immediately.
    if (sessionStorage.getItem(KEY) === '1') {
      unlock();
      return;
    }

    // Not unlocked: show the gate (content is hidden by the `locked` class,
    // applied inline in <head> so it never flashes).
    gate.hidden = false;

    function check() {
      // Forgiving of what real keyboards and password managers do: stray capital,
      // trailing space, autofilled casing.
      const entered = input.value.trim().toLowerCase();
      if (entered === PASSWORD) {
        sessionStorage.setItem(KEY, '1');
        unlock();
      } else {
        error.hidden = false;
        input.value = '';
        input.focus();
        // Restart the shake even on rapid repeat wrong guesses.
        form.classList.remove('shake');
        void form.offsetWidth; // force reflow so the animation replays
        form.classList.add('shake');
        input.classList.add('wrong');
      }
    }

    // Clear the red state as soon as the user starts typing again.
    input.addEventListener('input', () => {
      input.classList.remove('wrong');
      error.hidden = true;
    });

    // Bind every path explicitly rather than trusting native form submission,
    // which was observed NOT to fire on Enter in some browsers — leaving the
    // user pressing Enter with nothing happening. Button click, Enter keydown,
    // and form submit all route to the same check.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      check();
    });
    form.querySelector('.gate-submit').addEventListener('click', (e) => {
      e.preventDefault();
      check();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        check();
      }
    });
  })();
</script>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow: hidden;
  }

  /* An author `display: flex` overrides the browser's built-in
     `[hidden] { display: none }`, so `gate.hidden = true` alone wouldn't hide
     the overlay — it would stay on top of the gallery. This higher-specificity
     rule makes the hidden attribute actually hide it. */
  .gate[hidden] {
    display: none;
  }

  .gate-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Darken the photo so the white form stays readable. */
  .gate-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(20, 17, 14, 0.35),
      rgba(20, 17, 14, 0.55)
    );
  }

  .gate-form {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 20rem;
    text-align: center;
    color: #fff;
  }

  .gate-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .gate-label {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  .gate-row {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }

  .gate-input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 0.85rem;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
    outline: none;
    transition: border-color 0.15s;
  }

  .gate-input:focus {
    border-color: var(--text);
  }

  .gate-input.wrong,
  .gate-input.wrong:focus {
    border-color: #c0392b;
    background: #f7e6e2;
    color: #c0392b;
  }

  .gate-form.shake {
    animation: gate-shake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  @keyframes gate-shake {
    10%, 90% { transform: translateX(-2px); }
    20%, 80% { transform: translateX(4px); }
    30%, 50%, 70% { transform: translateX(-8px); }
    40%, 60% { transform: translateX(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate-form.shake {
      animation: none;
    }
  }

  .gate-submit {
    padding: 0.7rem 1.1rem;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--bg);
    background: var(--text);
    border: 1px solid var(--text);
    border-radius: 3px;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .gate-submit:hover {
    opacity: 0.85;
  }

  .gate-submit:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .gate-error {
    font-size: 0.78rem;
    color: #ff9182;
    margin: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .gate-version {
    position: fixed;
    z-index: 2;
    bottom: 0.75rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }
</style>
